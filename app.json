{
  "expo": {
    "name": "HURO",
    "slug": "huro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/HURO_ICON.png",
    "scheme": "huro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.huro.app"
    },
    "android": {
      "package": "com.huro.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/HURO_ICON.png",
        "backgroundColor": "#1C74E9"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow IsokoLink to access your camera to scan delivery QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.631103835596-vjmmeusmr808s60pajd7d0f5oeh32roi"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/HURO_ICON.png",
          "androidMode": "default",
          "androidCollapsedTitle": "%(count)s new notifications"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0c404cdb-8261-40b1-a05f-58c894ff48db"
      }
    },
    "owner": "shemaarnaud69"
  }
}
